{
  "name": "numbers-converter",
  "productName": "Numbers Converter",
  "version": "1.4.0",
  "description": "Convert Apple Numbers files to Excel, offline.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": ".venv\\Scripts\\python -W ignore py/test_numbers_tool.py && node test/convert.test.js",
    "build:helper": ".venv\\Scripts\\pyinstaller --noconfirm --onedir --name numbers-tool --distpath py/dist --workpath py/build --specpath py/build --collect-submodules numbers_parser --collect-data numbers_parser --exclude-module numpy --exclude-module openpyxl --exclude-module tkinter py/numbers_tool.py",
    "dist": "npm run build:helper && electron-builder --win --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/silent-diffusion/numbers-converter.git"
  },
  "author": "silent-diffusion",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.9.3": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "io.github.silent-diffusion.numbers-converter",
    "productName": "Numbers Converter",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "py/dist/numbers-tool",
        "to": "numbers-tool"
      }
    ],
    "fileAssociations": [
      {
        "ext": "numbers",
        "name": "Apple Numbers Spreadsheet",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "NumbersConverter-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Numbers Converter"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "silent-diffusion",
        "repo": "numbers-converter",
        "releaseType": "release"
      }
    ]
  }
}
